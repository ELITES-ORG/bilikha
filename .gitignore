# Scratch files from manual API testing. Cookie jars and request bodies hold
# session ids and test passwords, so they must never reach the repository.
tmp-*
# Scratch output from verification runs — cookie jars and login payloads
# land here, so it must never be committable (added after `git add -A` swept
# 22 such files in on 2026-09-22).
tmp/
*.cookies
cookies.txt

# Local Supabase CLI scratch
supabase/.temp/
issue.md

# code-review-graph — local tooling, never shared repository state.
# The graph database, the MCP server config, the skills it installs, and the
# pre-commit hook it adds to the otherwise-tracked .githooks/ (it shells out to
# a binary nobody else has). CLAUDE.md stays tracked on purpose: its rules
# apply to everyone, not just whoever has this tool installed.
.code-review-graph/
.claude/
.mcp.json
.githooks/pre-commit
