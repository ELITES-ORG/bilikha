{
  "name": "@bilikha/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bilikha API - Biliran Creative Industries Registry",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "admin:reset-password": "tsx src/scripts/reset-password.ts",
    "admin:grant": "tsx src/scripts/grant-admin.ts",
    "migrate:inquiries": "tsx src/scripts/migrate-inquiries.ts",
    "migrate:offers": "tsx src/scripts/migrate-portfolio-to-offers.ts",
    "media:prune": "tsx src/scripts/prune-orphan-media.ts",
    "notifications:prune": "tsx src/scripts/prune-notifications.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
