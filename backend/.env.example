NODE_ENV=development
PORT=4000

# Local Docker Postgres (see docker-compose.yml at the repo root)
DATABASE_URL=postgresql://bilikha:bilikha@localhost:5432/bilikha

# Comma-separated. Add the deployed frontend origin before going live.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=debug

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-64-hex-characters-minimum-32-chars
SESSION_TTL_DAYS=30

# Supabase Storage — Settings → API. Service role is the secret key, never the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-service-role-key
SUPABASE_STORAGE_BUCKET=media
# Private bucket for ID photos (ADR 0057) — never the media bucket. See docs/getting-started/local-setup.md.
SUPABASE_ID_BUCKET=ids
# Media kinds besides images that accept uploads: audio,video,document.
# Empty means images only (ADR 0046).
MEDIA_UPLOAD_KINDS=

# Keys the hash of ID numbers (plan 0053). Optional; at least 32 characters when set.
# Left empty on purpose: blank means unset, and the API warns at boot. Generate
# your own with: openssl rand -hex 32 — and NEVER rotate it once IDs are decided.
ID_HASH_SECRET=

# Optional. Sentry DSN for error reports; leave empty to report nothing (ADR 0053).
# RENDER_GIT_BRANCH and RENDER_GIT_COMMIT are set by Render itself — never add them here.
SENTRY_DSN=
